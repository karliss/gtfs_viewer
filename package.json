{
  "name": "gtfs-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && esbuild src/main.ts --bundle --outfile=dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "esbuild src/gtfs.ts --bundle --platform=node --format=cjs --outfile=dist/gtfs.cjs && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.16",
    "esbuild": "^0.25.0",
    "typescript": "7.0.2"
  }
}
